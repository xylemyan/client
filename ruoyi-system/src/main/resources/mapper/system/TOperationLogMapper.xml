<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cruoyi.system.mapper.TOperationLogMapper">
    
    <resultMap type="TOperationLog" id="TOperationLogResult">
        <result property="logId"        column="log_id"        />
        <result property="operatorId"   column="operator_id"   />
        <result property="operatorRole" column="operator_role" />
        <result property="opType"       column="op_type"       />
        <result property="opDetail"     column="op_detail"     />
        <result property="opTime"       column="op_time"       />
        <result property="txHash"       column="tx_hash"       />
        <result property="blockNumber"  column="block_number"  />
        <result property="dataHash"     column="data_hash"     />
    </resultMap>

    <sql id="selectTOperationLogVo">
        select log_id, operator_id, operator_role, op_type, op_detail, op_time, tx_hash, block_number, data_hash
        from t_operation_log
    </sql>

    <select id="selectTOperationLogByLogId" parameterType="Long" resultMap="TOperationLogResult">
        <include refid="selectTOperationLogVo"/>
        where log_id = #{logId}
    </select>

    <select id="selectTOperationLogList" parameterType="TOperationLog" resultMap="TOperationLogResult">
        <include refid="selectTOperationLogVo"/>
        <where>
            <if test="operatorId != null and operatorId != ''">
                AND operator_id = #{operatorId}
            </if>
            <if test="operatorRole != null and operatorRole != ''">
                AND operator_role = #{operatorRole}
            </if>
            <if test="opType != null and opType != ''">
                AND op_type like concat('%', #{opType}, '%')
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND op_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND op_time &lt;= #{params.endTime}
            </if>
        </where>
        order by op_time desc
    </select>

    <insert id="insertTOperationLog" parameterType="TOperationLog" useGeneratedKeys="true" keyProperty="logId">
        insert into t_operation_log (
            operator_id,
            operator_role,
            op_type,
            op_detail,
            op_time,
            tx_hash,
            block_number,
            data_hash
        ) values (
            #{operatorId},
            #{operatorRole},
            #{opType},
            #{opDetail},
            #{opTime},
            #{txHash},
            #{blockNumber},
            #{dataHash}
        )
    </insert>

    <delete id="cleanOperationLog">
        truncate table t_operation_log
    </delete>

</mapper>
